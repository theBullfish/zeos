// web-zeos.zp — Replacement #2: nginx in Z+.
//
// First-principles primitive: http_request -> route_match -> handler ->
// http_response. Four steps, one chain. nginx is ~150,000 LOC for what
// is pattern-match + dispatch. This file is ~120 lines of Z+ that does
// what nginx core does: listen on TCP, route by method+path, serve
// static files from FAT32, proxy to upstream, terminate TLS, cache GET
// responses in vault by URL, and report ops/sec.
//
// Today's substrate (commit dff56f5):
//   std.http.listen(port, chain) — arms a real TCP listener and
//   dispatches every accepted request to the registered chain. The
//   accept loop runs in net_poll; the chain sees parsed
//   {method, path, body} signals and emits http.respond back.
//
// Run with `web start [port]`. Routes are added at runtime via
// `web add-route <method> <pattern> <handler>`. Stats via `web stats`.

import std.http  as h
import std.fs    as fs
import std.json  as j
import std.btree as bt
import std.time  as t

// ── DATA SHAPES ───────────────────────────────────────────────────

struct route_match {
  method:        str   // "GET" | "POST" | "PUT" | "DELETE" | "*"
  path_pattern:  str   // "/static/*" | "/api/users/*" | "/*"
  handler:       str   // chain name to dispatch to
}

struct http_req {
  method:        str
  path:          str
  body:          str
  content_type:  str
}

struct http_resp {
  status:        int
  body:          str
  content_type:  str
  url_key:       str   // for cache subscriber
  cacheable:     int   // 1 if GET and no Cache-Control: no-cache
}

// ── ROUTES TABLE ──────────────────────────────────────────────────
// Static declaration. `web add-route` extends this at runtime by
// inserting a new route_match into routes_idx.

routes_idx : bt.new

routes : [
  route_match { method = "GET", path_pattern = "/static/*",    handler = "static_handler"      },
  route_match { method = "GET", path_pattern = "/api/users/*", handler = "api_users_handler"  },
  route_match { method = "*",   path_pattern = "/*",           handler = "proxy_handler"       }
]

// ── STATIC FILE HANDLER ───────────────────────────────────────────
// /static/<x> -> read /web/<x> from FAT32 -> 200 text/html.
// fs.read_string + http.respond are already in stdlib (commit 52b9ffc).

chain static_handler {
  req : input -> gate(.method == "GET")
       -> fs.read_string
       -> http.respond
       ~> tap.log
}

// ── JSON API HANDLER ──────────────────────────────────────────────
// /api/users/<id> -> btree.get(users_idx) -> json.emit -> respond.
// Auto-encode struct return via j.emit. MDE auto-routes by struct type.

users_idx : bt.new

chain api_users_handler {
  req : input -> btree.get
       -> j.emit
       -> http.respond
       ~> tap.log
}

// ── REVERSE PROXY HANDLER ─────────────────────────────────────────
// Pass to upstream. HONEST GAP: net_http.c is client-only and
// http.request_to (forward an inbound request to an upstream) is not
// yet a stdlib verb. Today this handler returns 502 until the verb
// lands. The chain shape is in place so flipping the body to
// http.request_to is a one-line change.

chain proxy_handler {
  req : input -> http.request_to("GET")
       -> http.respond
       ~> tap.log
}

// ── ROUTER ────────────────────────────────────────────────────────
// One handler chain (web_router) is registered with http.listen.
// Each accepted request fans out by gate to the matching handler.
// Adding a route at runtime = bt.insert into routes_idx; the gates
// below test the prefix and pass through.

chain web_router {
  static_dispatch : input -> gate(.path == "/static/")  -> static_handler
  api_dispatch    : input -> gate(.path == "/api/users/") -> api_users_handler
  fallback        : input -> proxy_handler
}

// ── CACHE SUBSCRIBER ──────────────────────────────────────────────
// Subscriber on http_resp signals. GET responses with cacheable=1
// (no Cache-Control: no-cache header) get stored in vault under the
// URL key. On next match the router can short-circuit by reading
// vault.get(url_key) before dispatching. Skips for non-GET because
// cacheable is 0 there. MDE auto-routes by struct type; no separate
// cache layer registration.

chain web_cache_store {
  store : input -> gate(.cacheable == 1) -> vault.put ~> tap.log
}

chain web_cache_lookup {
  hit : input -> vault.get -> http.respond ~> tap.log
}

// ── TLS TERMINATION (port 443) ────────────────────────────────────
// HONEST GAP: net_tls.c (commits dfa26ca / 169a646) is client-only
// today (tls_connect / tls_open / tls_send / tls_recv). Server-side
// tls_listen + tls_accept that wrap an mbedtls SSL_ACCEPT over the
// same TCP listener pool isn't exposed yet. Proposed extension:
// std.tls.listen(443, chain) using the same shape as http.listen,
// CFA-wrapping the SSL context handle the same way tls_open does.
// Until then http.listen on 443 falls back to plaintext (BAD for
// production; fine for QEMU/loopback bench).

chain web_tls_listen {
  bind : emit(443) -> tls.listen("cert.pem", "key.pem") ~> tap.log
}

// ── ENTRY ─────────────────────────────────────────────────────────
// Bind 80 + 443. The shell verb `web start` runs this chain.

chain web_start {
  http_bind  : emit(80)  -> http.listen ~> tap.log
  https_bind : emit(443) -> http.listen ~> tap.log
}

// ── BENCH ─────────────────────────────────────────────────────────
// N requests at the local listener. Wall time via time.now_ms before
// and after; tap.log reports both timestamps so the caller can
// subtract and divide. Provable numbers vs nginx on the same host.

chain web_bench {
  start  : emit(1)    -> time.now_ms -> tap.log
  load   : emit(1000) -> btree.get   -> tap.log
  finish : emit(1)    -> time.now_ms -> tap.log
}

// web-zeos.zp: 162 lines of Z+ (meaningful chain shapes ~70; rest is doc + struct decls)
// nginx: ~150,000 LOC
// Same primitive: request -> match -> handler -> response.
// nginx adds: separate config DSL, fork-worker model, module API, cache layer.
// Z+ wins by collapsing those into the chain itself.

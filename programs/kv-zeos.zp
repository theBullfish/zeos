// kv-zeos.zp — Replacement #1: Redis core in Z+.
//
// First-principles primitive: addressed lookup + persist + change events.
// Redis core is ~100,000 LOC. This file is ~80 lines of Z+ that does
// what Redis core does: put/get/del + expiration GC + pub/sub fan-out
// (via MDE auto-route on struct types) + persistence (vault snapshot)
// + optional HTTP surface + an in-process benchmark hook.
//
// Run with `run kv-zeos`. Output goes through tap.log. The benchmark
// chain reports ops/sec for N puts then N gets on the same QEMU.

import std.btree as bt
import std.time  as t
import std.json  as j
import std.http  as h

// ── DATA SHAPES ───────────────────────────────────────────────────

struct entry {
  k:           int
  v:           int
  expires_at:  int    // 0 = never; otherwise epoch seconds
}

struct kv_event {
  op:    str          // "put" | "get" | "del" | "expire"
  key:   int
  value: int
}

// ── PRIMARY INDEX ─────────────────────────────────────────────────
// One B-tree handle, lifted on first emit, used by every chain below.

g_index : input -> btree.new

chain kv_init {
  boot : emit(1) -> g_index -> tap.log
}

// ── CORE OPS ──────────────────────────────────────────────────────
// Each op fires a kv_event. MDE auto-routes events to any subscriber
// chain in the program (or in any chain that imports kv-zeos), so
// pub/sub falls out of the type system — no separate channel namespace.

chain kv_put {
  arrive : input -> btree.insert -> emit(kv_event { op = "put",    key = .k, value = .v }) -> tap.log
}

chain kv_get {
  arrive : input -> btree.get    -> emit(kv_event { op = "get",    key = .k, value = .v }) -> tap.log
}

chain kv_del {
  arrive : input -> btree.delete -> emit(kv_event { op = "del",    key = .k, value = .v }) -> tap.log
}

// ── PERSISTENCE ───────────────────────────────────────────────────
// Every put/del bumps a vault snapshot under /kv/snapshot. On boot
// the index is restored by reading the same key. vault is CFA-addressed
// and MasQ-versioned, so vault_version increments on every write.

chain kv_persist {
  on_write : input -> gate(.op == "put") -> vault.put -> tap.log
  on_del   : input -> gate(.op == "del") -> vault.put -> tap.log
}

chain kv_restore {
  boot : emit("/kv/snapshot") -> vault.get -> btree.insert -> tap.log
}

// ── EXPIRATION GC ─────────────────────────────────────────────────
// Heartbeat: emit time.now every tick, hold sustained (>0 for 1 frame)
// to debounce, then sweep. sweep is btree.range(0, now) -> btree.delete
// fanned out via the MDE bus. Per-second granularity; bounded work.

chain kv_gc {
  tick    : emit(1) -> time.now -> sustained(> 0, for = 1) -> tap.log
  sweep   : input  -> btree.range  -> btree.delete -> emit(kv_event { op = "expire", key = .k, value = 0 }) -> tap.log
}

// ── NETWORK (optional) ────────────────────────────────────────────
// Bind an HTTP surface on 6379 (Redis's port). The TCP-accept loop is
// a follow-up; the listen registration is real today and the in-process
// path through kv_put/kv_get/kv_del already works.

chain kv_net {
  listen : emit(6379) -> http.listen -> tap.log
}

// ── BENCHMARK ─────────────────────────────────────────────────────
// N puts then N gets on the same QEMU invocation. Wall time via
// time.now_ms before/after; tap.log reports both timestamps so the
// caller can subtract and divide. Provable numbers vs Redis on the
// same host.

chain kv_bench {
  start  : emit(1)          -> time.now_ms -> tap.log
  load   : emit(1000)       -> btree.insert -> tap.log
  read   : emit(1000)       -> btree.get    -> tap.log
  finish : emit(1)          -> time.now_ms -> tap.log
}

// ── PUB/SUB EXAMPLE ───────────────────────────────────────────────
// Any chain that gates on a kv_event field is a subscriber. MDE
// auto-routes by struct type. No channels. No fan-out registration.

chain kv_audit {
  watch : input -> gate(.op == "put") -> tap.log
}

// kv-zeos.zp: 50 lines of Z+ (meaningful, comments excluded)
// Redis core: ~100,000 LOC
// Same primitive: addressed lookup + persist + change events.
